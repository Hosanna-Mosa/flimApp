# Copy to backend/.env and fill in real values. NEVER commit the filled file.

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=Cluster0
PORT=8000
NODE_ENV=production

# JWT - generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=<32-byte-random-hex>
JWT_REFRESH_SECRET=<different-32-byte-random-hex>
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Message encryption - generate with: openssl rand -hex 32
MESSAGE_ENCRYPTION_KEY=<32-byte-random-hex>

# Cloudinary
CLOUDINARY_CLOUD_NAME=<cloud-name>
CLOUDINARY_API_KEY=<api-key>
CLOUDINARY_API_SECRET=<api-secret>

# Redis
ENABLE_REDIS=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# SMTP
SMTP_USER=<smtp-user>
SMTP_PASS=<smtp-app-password>
SUPPORT_ADMIN_EMAIL=<where-support-requests-are-sent>

# Razorpay
RAZORPAY_KEY_ID=<razorpay-key-id>
RAZORPAY_KEY_SECRET=<razorpay-key-secret>

# Twilio Verify
TWILIO_SID=<twilio-account-sid>
TWILIO_AUTH_TOKEN=<twilio-auth-token>
TWILIO_VERIFY_SERVICE_SID=<twilio-verify-service-sid>

# Local development only. Never set to true in production: it accepts the
# fixed OTP 123456 when Twilio is unreachable.
# ALLOW_OTP_BYPASS=false

# --- Razorpay web checkout ---
# Absolute origin the *phone's browser* will hit. Must be reachable from the
# device, not just from the server: in dev that is your LAN IP (same host the
# app's EXPO_PUBLIC_API_URL points at), in production your API domain.
# Leave blank to derive it from the incoming request's Host header.
PUBLIC_BASE_URL=https://api.filmyconnect24.com

# Razorpay Dashboard > Settings > Webhooks. Point it at
# POST {PUBLIC_BASE_URL}/payments/webhook and subscribe to
# payment.captured, order.paid and payment.failed.
# Without this, a payment is only fulfilled if the user's browser makes it back.
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Extra deep-link prefixes the checkout browser may be redirected to, comma
# separated. myapp://, app.rork.filmy://, exp:// and https://filmyconnect24.com/
# are already allowed. Anything not listed is rejected (open-redirect guard).
APP_RETURN_URL_PREFIXES=

# Deep links (Universal Links / App Links)
# Without these the association files are still served, but empty, and every
# shared link opens a browser instead of the app. GET /health/deeplinks says
# whether they are set.
# Apple Developer → Membership → Team ID.
IOS_TEAM_ID=<10-char-team-id>
# Play Console → Setup → App integrity → App signing key certificate → SHA-256.
# Comma-separate to also list the upload key, so non-Play builds verify too.
ANDROID_SHA256_CERT_FINGERPRINTS=<AA:BB:CC:...>
# Host that serves this file and the /.well-known/ paths.
DEEPLINK_ORIGIN=https://filmyconnect24.com
# Numeric id from the App Store listing URL (apps.apple.com/app/id<THIS>).
IOS_APP_STORE_ID=<app-store-numeric-id>
